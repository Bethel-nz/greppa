{
  "name": "greppa",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "sumi dev",
    "build": "sumi build --external @memvid/sdk",
    "start": "sumi start",
    "test": "bun test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "sdk:build": "cd packages/sdk && bun run build",
    "sdk:test": "cd packages/sdk && bun test"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.1",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@bethel-nz/sumi": "^1.2.3",
    "@better-auth/api-key": "^1.6.11",
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@hono/zod-validator": "^0.7.0",
    "@memvid/sdk": "^2.0.159",
    "@scalar/hono-api-reference": "^0.9.13",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "@upstash/realtime": "^1.0.3",
    "@upstash/redis": "^1.34.0",
    "@upstash/workflow": "^0.2.0",
    "ai": "^7.0.4",
    "async-mutex": "^0.5.0",
    "better-auth": "^1.6.11",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "groq-sdk": "^1.1.2",
    "hono": "^4.12.12",
    "hono-openapi": "^0.4.8",
    "html-to-text": "^10.0.0",
    "p-queue": "^9.3.0",
    "p-retry": "^8.0.0",
    "pg": "^8.21.0",
    "ulid": "^3.0.2",
    "zod": "^4.0.0",
    "zod-openapi": "^5.3.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
