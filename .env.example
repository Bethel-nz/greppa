# Required
GREPPA_SESSION_SECRET=change-me-32-chars-or-more-please-please
GREPPA_PUBLIC_URL=http://localhost:3000
GREPPA_PROTOCOL_VERSION=1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/greppa
BETTER_AUTH_SECRET=change-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3009/api/v1/auth

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

QSTASH_URL=https://qstash-eu-central-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

GROQ_API_KEY=

# Internal API key for worker-to-Railway communication
INTERNAL_API_KEY=change-me-with-openssl-rand-base64-32

# Optional
GREPPA_ALLOWED_ORIGINS=http://localhost:5173,https://your-portfolio.example.com
GREPPA_SESSION_TTL_MS=172800000
GREPPA_RESUME_WINDOW_MS=300000
GREPPA_ALLOW_PUBLIC_DELETE=false
GREPPA_ALLOW_PUBLIC_STATS=false
GREPPA_RATE_IP_WINDOW_MS=60000
GREPPA_RATE_IP_LIMIT=60
GREPPA_RATE_SESSION_WINDOW_MS=60000
GREPPA_RATE_SESSION_LIMIT=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object storage (R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=greppa-memory

# Checkpoint local cache. CACHE_DIR must be persistent SSD-backed storage, not a
# serverless ephemeral filesystem. MAX_OPEN and MAX_CACHE_BYTES both apply:
# eviction runs until the open set and the byte budget are each satisfied.
# MAX_CACHE_BYTES accepts a byte count or a binary suffix (512mb, 8gb) and must
# exceed the largest single scope served, with headroom for a concurrent write.
CHECKPOINT_CACHE_DIR=./.greppa/checkpoint
CHECKPOINT_MAX_OPEN=16
CHECKPOINT_MAX_CACHE_BYTES=2gb
CHECKPOINT_IDLE_MS=300000

# Scope memory embeddings.
#
# The code default is `deterministic`: an offline bag-of-words provider with no
# network or key. Set a real provider in .env.local, NOT here. Bun skips
# .env.local when NODE_ENV=test, so `bun run` picks up the real provider while
# `bun test` stays hermetic. That is deliberate — do not "fix" it by moving
# EMBEDDING_PROVIDER into .env, or the test suite starts making paid API calls.
#
#   openrouter        nvidia/llama-nemotron-embed-vl-1b-v2:free, 2048d, multimodal
#                     NOTE: the ":free" suffix is required; the bare model id 404s.
#   google            gemini-embedding-001, 768/1536/3072 (Matryoshka)
#   openai-compatible any /v1/embeddings endpoint (OpenAI, NVIDIA NIM, self-hosted)
#   deterministic     offline, tests only
#
# Changing provider or dimension requires a reembedScope() pass per scope:
# vectors from different models are not comparable and the store refuses to mix them.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=
EMBEDDING_DIM=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
# openai-compatible only:
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Temporal weighting ("forgetting"). OFF by default — a half-life is a product
# decision that needs tuning against real usage, and an untuned decay silently
# degrades retrieval. Decay runs from the last time a chunk was touched, so a
# memory that keeps being recalled stays strong. It only ever DOWN-RANKS;
# nothing is deleted, and MEMORY_DECAY_FLOOR is the weight an infinitely old
# memory retains (0.25 = a quarter, so it stays findable).
MEMORY_DECAY_ENABLED=0
MEMORY_DECAY_HALF_LIFE_DAYS=30
MEMORY_DECAY_FLOOR=0.25
